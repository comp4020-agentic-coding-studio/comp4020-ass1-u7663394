---
import Layout from "../layouts/Layout.astro";
import { MAGNITUDES } from "../lib/magnitudes";
---

<Layout
  title="How big is a million?"
  description="Move through seven powers of ten: point, line, plane, volume, and finally one million points."
>
  <a class="skip" href="#scale">Skip to the scale</a>

  <main class="experience">
    <header class="masthead">
      <h1>How big is a million?</h1>
    </header>

    <figure class="stage" data-core-output>
      <div class="stage-frame" data-frame>
        <canvas
          class="stage-canvas"
          data-canvas
          role="img"
          aria-label={MAGNITUDES[0].aria}></canvas>
        <p class="render-fallback" data-render-fallback hidden>
          This browser cannot draw the 3D field. The seven magnitudes are still
          listed below.
        </p>
        <noscript>
          <p class="render-fallback">
            Turn on JavaScript to move through the 3D field. The full sequence
            is listed below.
          </p>
        </noscript>
      </div>

      <div class="scene-status" aria-hidden="true">
        <span data-step-label>01 / 07</span>
        <span class="scene-status-shape" data-shape-label>point</span>
      </div>

      <figcaption class="readout">
        <ol class="magnitudes" aria-live="polite">
          {
            MAGNITUDES.map((magnitude) => (
              <li class="magnitude" data-magnitude={magnitude.step}>
                <p class="magnitude-figure">
                  <span class="magnitude-numeral">{magnitude.numeral}</span>
                  <span class="magnitude-name">{magnitude.name}</span>
                </p>
                <p class="magnitude-note">{magnitude.note}</p>
                <p class="magnitude-counting">
                  Counting aloud: {magnitude.counting}
                </p>
              </li>
            ))
          }
        </ol>
        <p class="readout-measure" data-measure></p>
      </figcaption>

      <p class="payoff" data-payoff>
        Easy to say. More than eleven days to count.
      </p>
    </figure>

    <nav class="dock" id="scale" aria-label="Powers of ten">
      <label class="sr-only" for="magnitude-scale">Magnitude</label>
      <input
        id="magnitude-scale"
        class="dock-slider"
        type="range"
        min="0"
        max="6"
        step="1"
        value="0"
        list="magnitude-ticks"
        aria-describedby="dock-hint"
        aria-valuetext="1, one"
        data-core-interaction
        data-scale
      />
      <datalist id="magnitude-ticks">
        {
          MAGNITUDES.map((magnitude) => (
            <option value={magnitude.step} label={magnitude.numeral} />
          ))
        }
      </datalist>

      <div class="dock-scale" aria-hidden="true">
        <span>1</span>
        <i></i><i></i><i></i><i></i><i></i><i></i><i></i>
        <span>1M</span>
      </div>

      <div class="dock-row">
        <p class="dock-hint" id="dock-hint">
          Drag the scale or use <kbd>←</kbd> <kbd>→</kbd>
        </p>
        <div class="dock-nudges">
          <button
            type="button"
            class="nudge"
            aria-label="Ten times fewer"
            data-core-interaction
            data-back
            disabled
          >
            <span aria-hidden="true">←</span>
          </button>
          <button
            type="button"
            class="nudge"
            aria-label="Ten times more"
            data-core-interaction
            data-next
          >
            <span aria-hidden="true">→</span>
          </button>
        </div>
      </div>
    </nav>
  </main>

  <script>
    import { start } from "../scripts/explainer";

    start();
  </script>
</Layout>
